{
  "C# Class": {
    "prefix": "cls",
    "body": [
      "namespace ${1:Namespace}",
      "",
      "public class ${2:ClassName}",
      "{",
      "    $0",
      "}",
    ],
    "description": "New C# Class"
  },
  "C# Interface": {
    "prefix": "inf",
    "body": [
      "namespace ${1:Namespace}",
      "",
      "public interface ${2:InterfaceName}",
      "{",
      "    $0",
      "}",
    ],
    "description": "New C# Interface"
  },
  "C# foreach": {
    "prefix": "foreach",
    "body": [
      "foreach (var ${2:x} in ${1:LIST})",
      "{",
      "   $0",
      "}"
    ]
  },
  "C# for": {
    "prefix": "for",
    "body": [
      "for (var ${2:i} = 0; i < ${1:length}; ${3:${2:i}++})",
      "{",
      "   $0",
      "}"
    ]
  },
  "C# summary comment": {
    "prefix": "summary",
    "body": [
      "/// <summary>",
      "/// $0",
      "/// </summary>"
    ]
  }
}